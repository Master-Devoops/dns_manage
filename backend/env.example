# --- Server ---
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:81

# --- Database ---
# NOTE: When running via `docker compose up`, DATABASE_URL is automatically
# constructed from the root-level `.env` file (POSTGRES_USER/PASSWORD/DB) and
# will OVERRIDE whatever you put here — see ../.env.example. This value below
# is only used for local (non-Docker) development, e.g. `npm run start:dev`.
DATABASE_URL=postgresql://devoops:devoops_password@localhost:5432/devoops_dns?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m

# --- GoDaddy API ---
# Get these from https://developer.godaddy.com/keys (Production key for a real domain)
GO_DADDY_API_KEY=
GO_DADDY_API_SECRET=
GO_DADDY_API_BASE_URL=https://api.godaddy.com
GO_DADDY_DOMAIN=devoops.in

# --- Seed (first Super Admin user, created on first `prisma:seed` run) ---
SEED_ADMIN_EMAIL=devoops.in@gmail.com
SEED_ADMIN_PASSWORD=Admin@321
