PORT=4000
NODE_ENV=development

# App login — seeded into MySQL as admin on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=replace-with-a-long-random-secret

# GoDaddy API credentials
# Create at: https://developer.godaddy.com/keys
GODADDY_API_KEY=your_api_key
GODADDY_API_SECRET=your_api_secret

# Use production API by default. Set to "ote" for GoDaddy OTE sandbox.
GODADDY_ENV=production

# Comma-separated list of domains you manage (optional filter).
# Leave empty to list all domains from your GoDaddy account.
MANAGED_DOMAINS=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dns_manage
