    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.19.1",
    "prisma": "^5.19.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "bcrypt": "^5.1.1",
